# Copy to .env for the Node server (npm start / npm run dev).
# For the Cloudflare Worker use wrangler.toml [vars] and `wrangler secret put`.

PORT=3000
# Address phones should open. Leave blank on a LAN (auto-detects this machine's IP).
# PUBLIC_URL=https://quippy.party

# ---- AI brain (Callback Club) ------------------------------------------------
# auto | ollama | lmstudio | vercel | openai-compatible | none
LLM_PROVIDER=auto
# LLM_MODEL=llama3.1:8b                 # local example; auto-picks an installed model if blank
# LLM_MODEL=anthropic/claude-opus-5.5   # Vercel AI Gateway example (the default there)
# AI_GATEWAY_API_KEY=
# LLM_BASE_URL=http://my-gpu-box:11434/v1
# LLM_API_KEY=
# LLM_TIMEOUT_MS=30000

# ---- Host voice ---------------------------------------------------------------
# Tried in order: local voice model, AI Gateway speech, ElevenLabs, then browser voices.
# auto (= local,gateway,elevenlabs) | local | elevenlabs | browser | e.g. "elevenlabs,local"
TTS_PROVIDER=auto
# Any OpenAI-style speech server (Kokoro-FastAPI, openedai-speech, ...)
TTS_LOCAL_URL=http://localhost:8880/v1
TTS_LOCAL_VOICE=bm_george
TTS_LOCAL_SPEED=0.95
# TTS_LOCAL_MODEL=
# TTS_LOCAL_API_KEY=
# Vercel AI Gateway speech (uses AI_GATEWAY_API_KEY above). Cheap, steerable.
# TTS_GATEWAY_MODEL=google/gemini-3.8-flash-tts
# TTS_GATEWAY_VOICE=Charon
# TTS_GATEWAY_INSTRUCTIONS=You are Monty, a dry, deadpan game-show host...
# Optional ElevenLabs route. Use a voice you have the rights to.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# ---- Game defaults ------------------------------------------------------------
QUIPPY_LOCALE=en-AU
QUIPPY_ANSWER_CHARS=200
QUIPPY_ANSWER_SECONDS=90
QUIPPY_VOTE_SECONDS=20
QUIPPY_FINAL_ANSWER_SECONDS=75
QUIPPY_FINAL_VOTE_SECONDS=30
QUIPPY_ROOM_TTL_HOURS=24
# QUIPPY_DEV=1
